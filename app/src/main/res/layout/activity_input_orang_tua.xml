<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Input Data Orang Tua / Wali"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#00A896"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- FORM ORANG TUA -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>
                    <Spinner
                        android:id="@+id/spinnerStatusOT"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_spinner"/>
                        
                    <EditText
                        android:id="@+id/etNamaOrangTua"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nama Orang Tua"
                        android:inputType="textPersonName|textCapWords"
                        android:layout_marginBottom="12dp"/>
                        
                    <EditText
                        android:id="@+id/etNoHpOrangTua"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nomor WhatsApp (cth: 6281...)"
                        android:inputType="phone"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TOMBOL -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimpanOrangTua"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="SIMPAN DATA"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="#00A896"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp"/>

            <!-- DAFTAR ORANG TUA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daftar Kontak Orang Tua"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrangTua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <TextView
                android:id="@+id/tvKosongOT"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Belum ada data orang tua yang tersimpan."
                android:gravity="center"
                android:textColor="#888888"
                android:visibility="gone"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
