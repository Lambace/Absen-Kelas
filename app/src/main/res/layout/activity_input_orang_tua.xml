<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Input Data Orang Tua / Wali"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#00A896"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <!-- PILIH KELAS & SISWA -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih Kelas:"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>
            <Spinner
                android:id="@+id/spinnerKelasOT"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih Siswa:"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>
            <Spinner
                android:id="@+id/spinnerSiswaOT"
                android:layout_width="match_parent"
                android:layout_height="48dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- FORM ORANG TUA -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data Orang Tua / Wali"
                        android:textStyle="bold"
                        android:textColor="#00A896"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status:"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>
                    <Spinner
                        android:id="@+id/spinnerStatusOT"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"/>
                    <EditText
                        android:id="@+id/etNamaOrangTua"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nama Orang Tua / Wali"
                        android:inputType="textPersonName|textCapWords"/>
                    <EditText
                        android:id="@+id/etNoHpOrangTua"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nomor HP / WhatsApp"
                        android:inputType="phone"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TOMBOL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSimpanOrangTua"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="SIMPAN"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:backgroundTint="#00A896"
                    android:textColor="#FFFFFF"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHapusOrangTua"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="HAPUS SEMUA"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    android:textColor="#E53935"
                    app:strokeColor="#E53935"/>
            </LinearLayout>

            <!-- DAFTAR ORANG TUA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daftar Data Orang Tua"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrangTua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <TextView
                android:id="@+id/tvKosongOT"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Belum ada data orang tua yang tersimpan."
                android:gravity="center"
                android:textColor="#888888"
                android:visibility="gone"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
