<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:orientation="horizontal" android:gravity="center_vertical">

        <TextView android:id="@+id/tvTanggalRiwayat" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="2024-05-20" android:textColor="#000000"/>

        <TextView android:id="@+id/tvStatusRiwayat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hadir" android:textStyle="bold" android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:textColor="#FFFFFF" android:background="#4CAF50"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>