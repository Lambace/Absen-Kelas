<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAF9">

    <View
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/bg_header_curved" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:text="Selamat Datang,"
                        android:textColor="#CCFFFFFF"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/tvNamaGuru"
                        android:text="Bapak/Ibu Guru Hebat"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivFotoGuru"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_alignParentEnd="true"
                    android:src="@mipmap/ic_launcher_round"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="2dp" />
            </RelativeLayout>

            <!-- Search -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="25dp"
                app:cardCornerRadius="25dp"
                app:cardElevation="8dp">
                <androidx.appcompat.widget.SearchView
                    android:id="@+id/searchSiswa"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:iconifiedByDefault="false"
                    app:queryHint="Cari siswa, kelas, jurusan..." />
            </androidx.cardview.widget.CardView>

            <!-- Hasil Pencarian -->
            <LinearLayout
                android:id="@+id/layoutSearchResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="8dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Hasil Pencarian"
                        android:textStyle="bold"
                        android:textColor="#2D3436"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCloseSearch"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Tutup"
                        android:textColor="#D32F2F"
                        app:icon="@android:drawable/ic_menu_close_clear_cancel"
                        app:iconTint="#D32F2F"
                        app:iconPadding="4dp"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSearchResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>

            <!-- Tahun Ajaran -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="Tahun Ajaran:"
                        android:textStyle="bold"
                        android:layout_marginEnd="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <Spinner
                        android:id="@+id/spinnerTahunAjaran"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Menu -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAbsensiHarian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:padding="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:src="@android:drawable/ic_menu_today" app:tint="#4CAF50"/>
                    <TextView android:layout_marginStart="12dp" android:text="Absensi Harian"
                        android:textStyle="bold" android:textSize="16sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <GridLayout
                android:layout_marginTop="16dp"
                android:columnCount="2"
                android:useDefaultMargins="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.cardview.widget.CardView android:id="@+id/cardInputGuru" android:layout_columnWeight="1" app:cardCornerRadius="16dp" app:cardElevation="4dp" android:layout_width="0dp" android:layout_height="wrap_content"><LinearLayout android:gravity="center" android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_edit" app:tint="#00A896"/><TextView android:layout_marginTop="8dp" android:text="Data Guru" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout></androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/cardInputKelas" android:layout_columnWeight="1" app:cardCornerRadius="16dp" app:cardElevation="4dp" android:layout_width="0dp" android:layout_height="wrap_content"><LinearLayout android:gravity="center" android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_input_add" app:tint="#673AB7"/><TextView android:layout_marginTop="8dp" android:text="Input Kelas" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout></androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/cardInputSiswa" android:layout_columnWeight="1" app:cardCornerRadius="16dp" app:cardElevation="4dp" android:layout_width="0dp" android:layout_height="wrap_content"><LinearLayout android:gravity="center" android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_add" app:tint="#FF9800"/><TextView android:layout_marginTop="8dp" android:text="Input Siswa" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout></androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/cardInputNilai" android:layout_columnWeight="1" app:cardCornerRadius="16dp" app:cardElevation="4dp" android:layout_width="0dp" android:layout_height="wrap_content"><LinearLayout android:gravity="center" android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"><ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_menu_sort_by_size" app:tint="#E91E63"/><TextView android:layout_marginTop="8dp" android:text="Input Nilai" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout></androidx.cardview.widget.CardView>
            </GridLayout>

            <TextView android:layout_marginTop="25dp" android:text="Statistik Kelas" android:textSize="18sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvKelas" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <!-- TOMBOL BAWAH - JARAK ATAS DIPERBAIKI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:weightSum="3">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetDB"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="78dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Reset"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:maxLines="1"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp"
                    app:icon="@android:drawable/ic_menu_delete"
                    app:iconGravity="top"
                    app:iconSize="24dp"
                    app:iconPadding="6dp"
                    app:iconTint="@android:color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:backgroundTint="#D32F2F"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackup"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="78dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:text="Backup"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:maxLines="1"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp"
                    app:icon="@android:drawable/ic_menu_save"
                    app:iconGravity="top"
                    app:iconSize="24dp"
                    app:iconPadding="6dp"
                    app:iconTint="@android:color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:backgroundTint="#00A896"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRestore"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="78dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Restore"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:maxLines="1"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp"
                    app:icon="@android:drawable/ic_menu_upload"
                    app:iconGravity="top"
                    app:iconSize="24dp"
                    app:iconPadding="6dp"
                    app:iconTint="@android:color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:backgroundTint="#0288D1"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>