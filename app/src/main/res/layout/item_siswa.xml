<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSiswa"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvNamaSiswa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nama"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvAlert" />

        <TextView
            android:id="@+id/tvAlert"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:background="@drawable/bg_badge_orange"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:text="⚠ 6x"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintBaseline_toBaselineOf="@id/tvNamaSiswa"
            app:layout_constraintEnd_toStartOf="@id/layoutAksi" />

        <TextView
            android:id="@+id/tvNisSiswa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="NISN : 123"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNamaSiswa"
            app:layout_constraintEnd_toStartOf="@id/layoutAksi" />

        <TextView
            android:id="@+id/tvJenisKelamin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Laki-laki"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNisSiswa"
            app:layout_constraintEnd_toStartOf="@id/layoutAksi" />

        <LinearLayout
            android:id="@+id/layoutAksi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnWaSiswa"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_send"
                android:visibility="gone"
                app:tint="#42A5F5" />

            <ImageButton
                android:id="@+id/btnDetailSiswa"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_view"
                android:visibility="visible"
                app:tint="#EF5350" />

            <ImageButton
                android:id="@+id/btnEditSiswa"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_edit"
                android:visibility="gone"
                app:tint="#00A896" />

            <ImageButton
                android:id="@+id/btnHapusSiswa"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                android:visibility="gone"
                app:tint="#D32F2F" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>